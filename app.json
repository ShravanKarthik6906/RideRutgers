{
  "expo": {
    "name": "RideRutgers",
    "slug": "RideRutgers",
    "scheme": "riderutgers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.shravankarthik6906.riderutgers"
    },
    "android": {
      "package": "io.github.shravankarthik6906.riderutgers",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RideRutgers uses your location to match you with nearby rides and show live driver tracking."
        }
      ],
      "expo-font",
      "react-native-maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "RideRutgers uses your photo library to upload your driver's license and insurance card."
        }
      ]
    ]
  }
}
