EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of email domains allowed to sign in.
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAINS=rutgers.edu,scarletmail.rutgers.edu

# Only needed for a standalone/EAS Android build, not for Expo Go testing
# (Expo Go renders Google Maps on Android using its own bundled test key).
# Not EXPO_PUBLIC_-prefixed: it's read at build/config time only, into the
# native Android manifest, and is never inlined into the JS bundle.
GOOGLE_MAPS_API_KEY=
